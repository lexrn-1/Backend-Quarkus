# Configuración ilustrativa. Las credenciales se montan desde fuera del repositorio.
# Orígenes sin ruta ni barra final; APP_ALLOWED_ORIGINS tiene prioridad.
APP_ALLOWED_ORIGINS=https://frontln.vercel.app,http://localhost:4200,http://127.0.0.1:4200
# FRONTEND_ORIGIN se conserva como alternativa para Compose.
APP_PROOF_SESSION=local-proof
# Pendiente de decisión institucional. Vacío permite cualquier correo válido de Firebase.
APP_ALLOWED_EMAIL_DOMAINS=
# Para compose.dokploy.yaml, configurar HTTPS y valores reales:
# API_IMAGE=ghcr.io/organizacion/repositorio-backend-api:sha
# REALTIME_IMAGE=ghcr.io/organizacion/repositorio-backend-realtime:sha
# FIREBASE_PROJECT_ID=proyecto-real
# API_FIREBASE_CREDENTIALS_FILE=/ruta/externa/api-firebase.json
# REALTIME_FIREBASE_CREDENTIALS_FILE=/ruta/externa/realtime-firebase.json
# DOKPLOY_NETWORK=red-real-del-proxy
